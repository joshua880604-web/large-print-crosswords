---
import '../styles/global.css';
interface Props { title?: string; description?: string; active?: string; noindex?: boolean; breadcrumbs?: {name:string;path:string}[]; }
const {title='Free Large Print Crossword Puzzles — Play & Print', description='Enjoy free, easy large print crosswords. Play online at your own pace or print clear, easy-to-read puzzles with separate answer sheets.', active='', noindex=false, breadcrumbs=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const site=new URL('/',Astro.site).href;
const image=new URL('/social-card.png',Astro.site).href;
const graph:Record<string,unknown>[]=[
 {'@type':'WebSite','@id':`${site}#website`,url:site,name:'Large Print Crosswords',inLanguage:'en-US'},
 {'@type':'WebPage','@id':`${canonical}#webpage`,url:canonical.href,name:title,description,inLanguage:'en-US',isPartOf:{'@id':`${site}#website`},...(breadcrumbs.length?{breadcrumb:{'@id':`${canonical}#breadcrumb`}}:{})}
];
if(breadcrumbs.length)graph.push({'@type':'BreadcrumbList','@id':`${canonical}#breadcrumb`,itemListElement:breadcrumbs.map((crumb,index)=>({'@type':'ListItem',position:index+1,name:crumb.name,item:new URL(crumb.path,Astro.site).href}))});
const structuredData=JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="en-US"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta name="theme-color" content="#23483f"/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Large Print Crosswords"/><meta property="og:locale" content="en_US"/><meta property="og:image" content={image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Large Print Crosswords. Big letters. Clear clues. Free to play and print."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><meta name="twitter:image:alt" content="Large Print Crosswords. Big letters. Clear clues. Free to play and print."/>{!noindex&&<script type="application/ld+json" is:inline set:html={structuredData}/>}<meta property="og:url" content={canonical}/><title>{title}</title></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="header-inner"><a class="brand" href="/" aria-label="Large Print Crosswords home"><span class="brand-symbol" aria-hidden="true"><i>L</i><i></i><i>P</i><i>C</i></span><span>Large Print<br/><strong>Crosswords</strong></span></a><nav aria-label="Main navigation"><a href="/daily/" aria-current={active==='daily'?'page':undefined}>Daily puzzle</a><a href="/crosswords/" aria-current={active==='puzzles'?'page':undefined}>All puzzles</a><a href="/printable/" aria-current={active==='print'?'page':undefined}>Printables</a><a href="/how-to-play/" aria-current={active==='help'?'page':undefined}>How to play</a></nav><a class="button header-play" href="/daily/">Let’s play <span aria-hidden="true">→</span></a></div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="footer-top"><a class="footer-brand" href="/">A little puzzle.<br/><em>A lovely part of your day.</em></a><p>Big letters. Clear clues. Your own pace.<br/>Made for the simple joy of figuring things out.</p></div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} Large Print Crosswords</span><div><a href="/about/">About us</a><a href="/accessibility/">Accessibility</a><a href="/privacy/">Privacy</a></div><span>No account needed. Always a warm welcome.</span></div></footer>
</body></html>
