---
import Layout from '../layouts/Layout.astro';
import Game from '../components/Game.astro';
import puzzles from '../data/current-puzzles.mjs';
import {dailyDescription,dailySelection,dailyTitle} from '../data/daily.mjs';

const {date,readable,puzzle}=dailySelection(puzzles);
---
<Layout description={dailyDescription} title={dailyTitle} active="daily">
 <div class="container game-container">
  <div class="game-header">
   <div>
    <p class="eyebrow">Daily crossword selection · <time datetime={date}>{readable}</time></p>
    <h1>{puzzle.title}</h1>
    <p>{puzzle.description}</p>
   </div>
   <a class="button button-outline" href={`/print/${puzzle.id}/`}>Print this puzzle →</a>
  </div>
  <p class="notice daily-links">
   <a href={`/crosswords/${puzzle.id}/`}>Open this puzzle’s permanent link</a> · <a href={`/print/${puzzle.id}-answers/`}>Print answers</a>
  </p>
  <Game puzzle={puzzle}/>
  <p class="game-bottom">Need help starting? <a href="/how-to-play/">Read the instructions</a> or <a href="/crosswords/">browse all puzzles</a>.</p>
 </div>
</Layout>
