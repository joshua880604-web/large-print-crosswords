---
import Layout from '../../layouts/Layout.astro';import MiniGrid from '../../components/MiniGrid.astro';import puzzles from '../../data/puzzles.json';
export function getStaticPaths(){return puzzles.flatMap(p=>[{params:{slug:p.id},props:{puzzle:p,answers:false}},{params:{slug:p.id+'-answers'},props:{puzzle:p,answers:true}}]);}
const {puzzle,answers}=Astro.props;
---
<Layout noindex title={`${puzzle.title} — ${answers?'Answer Sheet':'Printable Crossword'}`}><div class="print-toolbar"><div class="print-controls"><button class="button" id="print-sheet">Print {answers?'answers':'puzzle'}</button><a class="button button-outline" href={`/print/${puzzle.id}${answers?'':'-answers'}/`}>{answers?'Puzzle sheet':'Separate answer sheet'}</a><a class="button button-outline" href={`/crosswords/${puzzle.id}/`}>Play online</a></div><p>Choose US Letter, portrait, and disable browser headers and footers. To download, choose “Save as PDF” in the print window.</p></div><article class="print-page"><p class="eyebrow">LARGE PRINT CROSSWORDS · {answers?'ANSWER SHEET':'EASY THEMED MINI'}</p><h1>{puzzle.title}{answers?' — Answers':''}</h1><p class="print-description">{puzzle.description}</p><div class="print-board" style={`--print-board-width:${3.6*Math.min(1,puzzle.cols/puzzle.rows)}in`}><MiniGrid puzzle={puzzle} filled={answers}/></div><div class="print-clues">{['across','down'].map(d=><section><h2>{d==='across'?'Across':'Down'}</h2>{puzzle.entries.filter(e=>e.direction===d).sort((a,b)=>a.number-b.number).map(e=><p><strong>{e.number}.</strong> {answers?e.answer:`${e.clue} (${e.answer.length})`}</p>)}</section>)}</div><p class="print-footer">largeprintcrosswords.com · Free to print for personal use and noncommercial group activities.</p></article></Layout>
<script>document.querySelector('#print-sheet')?.addEventListener('click',()=>window.print());</script>
