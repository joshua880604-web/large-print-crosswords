---
import PuzzleNotes from '../../components/PuzzleNotes.astro';import Layout from '../../layouts/Layout.astro';import Game from '../../components/Game.astro';import PuzzleCard from '../../components/PuzzleCard.astro';import puzzles from '../../data/puzzles.json';
import {christmasPuzzleIds} from '../../data/christmas';
export function getStaticPaths(){return puzzles.map(puzzle=>({params:{slug:puzzle.id},props:{puzzle}}));}
const {puzzle}=Astro.props;
const musicSeries=['music-memories','american-music','instrument-families','dance-and-song'];
const topic=christmasPuzzleIds.has(puzzle.id)?{path:'/christmas-crosswords/',name:'Christmas'}
 :puzzle.theme==='Sports'?{path:'/sports-crosswords/',name:'sports'}
 :musicSeries.includes(puzzle.series||'')?{path:'/music-crosswords/',name:'music'}
 :puzzle.series==='geography-journeys'||puzzle.series==='state-capital-stops'?{path:'/geography-crosswords/',name:'geography and state capitals'}
 :puzzle.series==='american-history-scenes'?{path:'/american-history-crosswords/',name:'American history'}
 :puzzle.series==='texas-scenes'?{path:'/texas-crosswords/',name:'Texas'}:null;
const breadcrumbs=[{name:'Home',path:'/'},{name:'Crosswords',path:'/crosswords/'},{name:puzzle.title,path:`/crosswords/${puzzle.id}/`}];
const related=puzzles.filter(p=>p.id!==puzzle.id&&p.theme===puzzle.theme).sort((a,b)=>Number(b.id.replace(/-\d+$/,'')===puzzle.id.replace(/-\d+$/,''))-Number(a.id.replace(/-\d+$/,'')===puzzle.id.replace(/-\d+$/,''))).slice(0,3);
---
<Layout title={`${puzzle.title} — Free Large Print Crossword`} description={`Play ${puzzle.title}, a free ${puzzle.rows} × ${puzzle.cols} large print crossword with ${puzzle.entries.length} easy clues. Play online or print the puzzle and separate answers.`} breadcrumbs={breadcrumbs} active="puzzles"><div class="container game-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/crosswords/">Crosswords</a> <span aria-hidden="true">/</span> <span aria-current="page">{puzzle.title}</span></nav><div class="game-header"><div><p class="eyebrow">{puzzle.theme} · EASY · {puzzle.entries.length} CLUES</p><h1>{puzzle.title}</h1><p>{puzzle.description}</p></div><a class="button button-outline" href={`/print/${puzzle.id}/`}>Print this puzzle →</a></div><Game puzzle={puzzle}/>{topic&&<p class="notice"><a href={topic.path}>Explore more {topic.name} crosswords →</a></p>}{puzzle.editorial&&<PuzzleNotes editorial={puzzle.editorial}/>}<details class="answer-details"><summary>Show the answer list (spoilers)</summary><p>{puzzle.entries.sort((a,b)=>a.number-b.number).map(e=>`${e.number} ${e.direction}: ${e.answer}`).join(' · ')}</p></details><div class="game-bottom"><h2>A little help, whenever you need it.</h2><p>Select a clue, then type your answer. Use <strong>Check word</strong> to check your work or <strong>Reveal letter</strong> for a gentle hint. This themed mini crossword has some letters that belong to just one word. <a href="/how-to-play/">Read the full instructions.</a></p></div></div>{related.length>0&&<section class="container section"><div class="section-heading"><h2>A little more {puzzle.theme.toLowerCase()}.</h2></div><div class="puzzle-cards">{related.map((p,i)=><PuzzleCard puzzle={p} index={i}/>)}</div></section>}</Layout>
