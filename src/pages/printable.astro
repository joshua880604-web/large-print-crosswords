---
import Collection from '../components/Collection.astro';
import FeaturedPuzzle from '../components/FeaturedPuzzle.astro';
import TopicLinks from '../components/TopicLinks.astro';
import puzzles from '../data/puzzles.json';
import Layout from '../layouts/Layout.astro';

const featured = [
  { theme: 'Gardening', ids: ['garden-harvest-baskets', 'garden-harvest-baskets-2'] },
  { theme: 'Nostalgia', ids: ['street-sights-remembered-2', 'family-photos-and-film-4'] },
  { theme: 'Food', ids: ['bakers-specialties-2', 'eating-at-the-diner-5'] },
].map(({ theme, ids }) => ({
  theme,
  puzzles: ids.map((id) => {
    const puzzle = puzzles.find((item) => item.id === id);
    if (!puzzle) throw new Error(`Missing featured printable puzzle: ${id}`);
    return puzzle;
  }),
}));
---
<Layout
  title="Free Printable Large Print Crosswords with Answers"
  description="Browse free printable large print crossword puzzles for seniors and adults. Easy-to-read clues, US Letter pages, and separate answer sheets. No sign-up."
  active="print"
  puzzleList={featured.flatMap(group => group.puzzles)}
>
  <div class="container print-directory">
    <header class="page-heading">
      <h1>Free printable large print crosswords.</h1>
      <p>Free for adults who prefer larger letters. No sign-up required.</p>
    </header>
    <section class="notice print-format-guide" aria-labelledby="print-format-heading">
      <h2 id="print-format-heading">Print or save as PDF</h2>
      <p><strong>Large: 18pt, two pages.</strong> Compact: 13pt, one page. Both use US Letter paper.</p>
      <p>Open a puzzle below and select <strong>Print puzzle</strong>. In your browser’s print window, choose a printer or <strong>Save as PDF</strong>. Open the separate answer sheet when you want to print or save the answers.</p>
    </section>
    <div class="print-directory-actions">
      <a class="button" href="/print-pack/">Choose puzzles for a print pack</a>
      <a href="#all-puzzles">Browse all puzzles</a>
    </div>
    <section class="featured-print" aria-labelledby="featured-print-heading">
      <h2 id="featured-print-heading">Featured puzzles to print</h2>
      <div class="featured-themes">
        {featured.map(({ theme, puzzles: featuredPuzzles }) => (
          <div class="featured-theme">
            <h3>{theme}</h3>
            <ul>
              {featuredPuzzles.map(puzzle => <FeaturedPuzzle puzzle={puzzle} printFirst/>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
    <section aria-labelledby="all-puzzles">
      <h2 id="all-puzzles">Browse all puzzles</h2>
      <Collection print deferCatalog/>
    </section>
    <TopicLinks/>
  </div>
</Layout>
<style>
  .print-directory .page-heading { padding-top: 32px; padding-bottom: 22px; }
  .print-format-guide h2 { margin-bottom: 8px; font-size: 22px; }
  .print-format-guide p + p { margin-top: 8px; }
  .print-directory-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin: 18px 0 32px; }
  .print-directory-actions a:not(.button) { text-decoration: underline; text-underline-offset: 3px; }
  .featured-print { margin-bottom: 40px; }
  .featured-themes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
  .featured-theme { padding: 16px; border: 1px solid var(--line); border-radius: 8px; background: #fffdf8; }
  .featured-theme ul { list-style: none; margin: 12px 0 0; padding: 0; }
  .featured-theme ul > :global(li + li) { border-top: 1px solid var(--line); padding-top: 8px; }
  #all-puzzles { margin-bottom: 16px; }
  @media (max-width: 800px) {
    .featured-themes { grid-template-columns: minmax(0, 1fr); }
  }
</style>
