---
import allPuzzles from '../data/puzzles.json';
import {catalogPageSize} from '../data/catalog';
import {collectionSearchText} from '../scripts/search';
import PuzzleCard from './PuzzleCard.astro';

const {items:puzzles=allPuzzles,print=false,deferCatalog=false}=Astro.props;
const themes=[...new Set(puzzles.map(p=>p.theme))];
const cards=deferCatalog ? puzzles.slice(0,catalogPageSize) : puzzles;
---
<div class="collection-tools">
 <label>Find a puzzle<input class="search-input" type="search" placeholder="Search titles or themes" id="puzzle-search" disabled/></label>
 <label>Choose a theme<select id="theme-select" disabled><option value="">All themes</option>{themes.map(t=><option value={t}>{t}</option>)}</select></label>
 <button type="button" class="button button-outline" id="clear-filters" hidden>Clear filters</button>
 <p class="result-count" role="status">{deferCatalog ? `Showing ${cards.length} of ${puzzles.length} puzzles` : `${puzzles.length} puzzles to enjoy`}</p>
</div>
<div class="collection-grid" data-catalog={deferCatalog ? '/puzzle-catalog.json' : undefined} data-total={puzzles.length} data-print={print ? 'true' : undefined}>
 <div class="puzzle-cards">
  {cards.map((p,i)=><div data-id={p.id} data-title={collectionSearchText(p)} data-theme={p.theme}>
   <PuzzleCard puzzle={p} index={i} print={print}/>
   {print&&<div role="group" class="print-card-links" aria-label={`More options for ${p.title}`}>
    <a href={`/print/${p.id}-answers/`} aria-label={`Answer sheet for ${p.title}`}>Answer sheet</a>
    <a href={`/crosswords/${p.id}/`} aria-label={`Play ${p.title} online`}>Play online</a>
   </div>}
  </div>)}
 </div>
 <button class="button button-outline more-puzzles" id="load-more" hidden>Show more puzzles</button>
 <p class="empty-state" hidden>No puzzles match just yet. Try another word or choose all themes.</p>
 {deferCatalog && <>
  <div class="catalog-error" hidden><p>Could not load more puzzles.</p><button type="button" class="button button-outline" id="retry-catalog">Try again</button></div>
  <noscript><p>Search and filters need JavaScript. Use the puzzle index to browse by page.</p></noscript>
  <p class="catalog-index-link"><a href="/puzzle-index/1/">Browse the text index</a></p>
 </>}
</div>
<style>
.print-card-links{display:flex;flex-wrap:wrap;gap:8px 20px;padding:8px 4px}.print-card-links a{display:inline-flex;align-items:center;min-height:48px;text-decoration:underline;text-underline-offset:3px;font-size:17px}
.more-puzzles,.catalog-index-link,.catalog-error{margin-top:24px}
.catalog-index-link a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:3px}
.catalog-error button{margin-top:8px}
</style>
<script>
import '../scripts/collection';
</script>
