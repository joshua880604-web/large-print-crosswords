---
const {puzzle,index=0}=Astro.props;
---
<a class={`puzzle-card tone-${index%4}`} href={`/crosswords/${puzzle.id}/`}><div class="card-art"><span class="pill">{puzzle.subtheme||puzzle.theme}</span><img class="mini-grid" src={`/previews/${puzzle.id}-v${puzzle.revision||1}.svg`} width={puzzle.cols*24} height={puzzle.rows*24} style="height:auto" alt="" aria-hidden="true" loading="lazy" decoding="async"/><span class="card-arrow" aria-hidden="true">→</span></div><div class="card-body"><div class="card-meta">EASY <span>•</span> {puzzle.rows} × {puzzle.cols}</div><h3>{puzzle.title}</h3><p>{puzzle.cardDescription||`${puzzle.entries.length} familiar clues. A little moment for you.`}</p><span class="card-link">Play or print <span aria-hidden="true">→</span></span></div></a>
