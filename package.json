{
  "name": "large-print-crosswords",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "node scripts/validate-puzzles.mjs && node scripts/audit-content.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/audit-seo.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "test": "node scripts/validate-puzzles.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "audit:seo": "node scripts/audit-seo.mjs",
    "social:generate": "node scripts/generate-social-card.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:playthrough": "node scripts/audit-playthrough.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
